<%- include('partials/head', { title: '2FA Setup — Secure Login' }) %>

<div class="auth-wrapper">
  <div class="auth-card" style="max-width:460px">
    <div class="auth-logo">🛡️</div>
    <h1 class="auth-title">Setup Two-Factor Auth</h1>
    <p class="auth-subtitle">Scan the QR code with your authenticator app</p>

    <% if (error) { %>
      <div class="alert alert-error"><%= error %></div>
    <% } %>

    <div style="text-align:center; margin:16px 0">
      <img src="<%= qrDataUrl %>" alt="QR Code" style="border:4px solid #e2e8f0; border-radius:8px; width:180px"/>
      <p style="font-size:12px; color:#64748b; margin-top:8px">
        Can't scan? Enter manually:<br/>
        <code style="background:#f1f5f9; padding:3px 6px; border-radius:4px; font-size:11px; word-break:break-all"><%= secret %></code>
      </p>
    </div>

    <form action="/auth/2fa-setup" method="POST">
      <input type="hidden" name="qrDataUrl" value="<%= qrDataUrl %>"/>
      <div class="form-group">
        <label>Enter 6-digit code from your app</label>
        <input type="text" name="token" maxlength="6" placeholder="e.g. 123456"
               autocomplete="one-time-code" inputmode="numeric"
               style="letter-spacing:0.3em; font-size:1.2rem; text-align:center" required />
      </div>
      <button type="submit" class="btn btn-primary btn-block">Verify & Enable 2FA</button>
    </form>

    <p class="auth-footer"><a href="/dashboard">← Back to Dashboard</a></p>
  </div>
</div>

</body></html>
